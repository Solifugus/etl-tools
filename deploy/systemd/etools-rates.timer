[Unit]
Description=Daily ETools Treasury yield load
Documentation=https://github.com/Solifugus/etl-tools

[Timer]
# Treasury posts the day's yield curve around 6:00 p.m. Eastern on business
# days; there is nothing new to fetch on a weekend. Times are the machine's
# local clock -- adjust if this box is not on Eastern time.
OnCalendar=Mon..Fri 18:30
RandomizedDelaySec=15m
# If the machine was asleep or off at 18:30, run at the next opportunity
# instead of skipping the day.
Persistent=true
Unit=etools-rates.service

[Install]
WantedBy=timers.target
